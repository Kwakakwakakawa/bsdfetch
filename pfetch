#!/bin/sh
#
# bsdfetch - Simple POSIX sh fetch script for BSD systems.
# Fork of pfetch: Linux/non-BSD support removed, OpenBSD memory
# detection fixed, disk partition reporting added.
# Wrapper around all escape sequences used by bsdfetch to allow for
# greater control over which sequences are used (if any at all).
esc() {
    case $1 in
        CUU) e="${esc_c}[${2}A" ;; # cursor up
        CUD) e="${esc_c}[${2}B" ;; # cursor down
        CUF) e="${esc_c}[${2}C" ;; # cursor right
        CUB) e="${esc_c}[${2}D" ;; # cursor left
        # text formatting
        SGR)
            case ${PF_COLOR:=1} in
                (1) e="${esc_c}[${2}m" ;;
                (0) e= ;; # colors disabled
            esac
            ;;
        # line wrap
        DECAWM)
            case $TERM in
                (dumb | minix | cons25) e= ;; # not supported
                (*) e="${esc_c}[?7${2}" ;;
            esac
            ;;
    esac
}

# Print a sequence to the terminal.
esc_p() {
    esc "$@"
    printf '%s' "$e"
}

# This is just a simple wrapper around 'command -v' to avoid
# spamming '>/dev/null' throughout this script. This also guards
# against aliases and functions.
has() {
    _cmd=$(command -v "$1") 2>/dev/null || return 1
    [ -x "$_cmd" ] || return 1
}

log() {
    # The 'log()' function handles the printing of information.
    # The size of the ascii art is stored and the ascii is printed
    # first. Once the ascii is printed, the cursor is located right
    # below the art ($[1]). Using the stored ascii size, the cursor
    # is moved up ($[2]), then right by the ascii width plus a gap
    # ($[3]). Each 'log()' call prints one info line ($[4], $[5])
    # until the information runs out. Finally the cursor is placed
    # below both art and info ($[6]) using:
    #     cursor_down = ascii_height - info_height
    #
    # $[2] ___      $[3] goldie@openbsd
    # $[4](.· |     $[5] os OpenBSD 7.6
    #     (<> |
    #    / __  \
    #   ( /  \ /|
    #  _/\ __)/_)
    #  \/-____\/
    # $[1]
    #
    # $[6] /home/goldie $
    # End here if no data was found.
    [ "$2" ] || return

    # Store the values of '$1' and '$3' as we reset the argument list below.
    name=$1
    use_seperator=$3

    # Use 'set --' as a means of stripping all leading and trailing
    # white-space from the info string. This also normalizes all
    # white-space inside of the string.
    # shellcheck disable=2046,2086
    {
        set -f
        set +f -- $2
        info=$*
    }

    # Move the cursor to the right, the width of the ascii art with an
    # additional gap for text spacing.
    esc_p CUF "$ascii_width"

    # Print the info name and color the text.
    esc_p SGR "3${PF_COL1-4}"
    esc_p SGR 1
    printf '%s' "$name"
    esc_p SGR 0

    # Print the info name and info data separator, if applicable.
    [ "$use_seperator" ] || printf %s "$PF_SEP"

    # Move the cursor backward the length of the *current* info name and
    # then move it forwards the length of the *longest* info name. This
    # aligns each info data line.
    esc_p CUB "${#name}"
    esc_p CUF "${PF_ALIGN:-$info_length}"

    # Print the info data, color it and strip all leading whitespace
    # from the string.
    esc_p SGR "3${PF_COL2-9}"
    printf '%s' "$info"
    esc_p SGR 0
    printf '\n'

    # Keep track of the number of times 'log()' has been run.
    info_height=$((${info_height:-0} + 1))
}

get_title() {
    # Username is retrieved by first checking '$USER' with a fallback
    # to the 'id -un' command.
    user=${USER:-$(id -un)}

    # Hostname is retrieved by first checking '$HOSTNAME' with a
    # fallback to the 'hostname' command.
    # shellcheck disable=3028,2039
    hostname=${HOSTNAME:-${hostname:-$(hostname)}}

    # If the hostname is still not found, fallback to /etc/myname on
    # OpenBSD and /etc/hostname elsewhere.
    if [ -z "$hostname" ]; then
        [ -f /etc/myname ] && read -r hostname < /etc/myname \
                           || read -r hostname < /etc/hostname
    fi

    # Add escape sequences for coloring to user and host name. As we
    # embed them directly in the arguments passed to log(), we cannot
    # use esc_p().
    esc SGR 1;  user=$e$user
    esc SGR "3${PF_COL3:-1}"; user=$e$user
    esc SGR 1;  user=$user$e
    esc SGR 1;  hostname=$e$hostname
    esc SGR "3${PF_COL3:-1}"; hostname=$e$hostname

    log "${user}@${hostname}" " " " " >&6
}

get_os() {
    # This function is called twice, once to detect the distribution
    # name for the purposes of picking an ascii art early and secondly
    # to display the name in the info output (if enabled).
    [ "$distro" ] && {
        log os "$distro" >&6
        return
    }

    case $os in
        (OpenBSD*)
            # Show the OpenBSD version type (current if present).
            # kern.version=OpenBSD 6.6-current (GENERIC.MP) ...
            IFS=' =' read -r _ distro openbsd_ver _ <<-EOF
$(sysctl kern.version)
EOF
            distro="$distro $openbsd_ver"
            ;;
        (FreeBSD)
            distro="$os $(freebsd-version)"
            ;;
        (*)
            # Catch all for NetBSD, DragonFly and friends:
            # ensures '$distro' is never blank.
            distro="$os $kernel"
            ;;
    esac
}

get_kernel() {
    case $os in
        # Don't print kernel output on BSDs as the OS name
        # already includes the version.
        (*BSD*) return ;;
    esac
}

get_host() {
    case $os in
        (FreeBSD* | DragonFly*)
            host=$(sysctl -n hw.model)
            ;;
        (NetBSD*)
            host=$(sysctl -n machdep.dmi.system-vendor \
                           machdep.dmi.system-product)
            ;;
        (OpenBSD*)
            host=$(sysctl -n hw.version)
            ;;
        (*)
            host=$(sysctl -n hw.vendor hw.product)
            ;;
    esac

    # Turn the host string into an argument list so we can iterate
    # over it and remove OEM strings and other information which
    # shouldn't be displayed.
    # shellcheck disable=2046,2086
    {
        set -f
        set +f -- $host
        host=
    }

    # Iterate over the host string word by word as a means of stripping
    # unwanted and OEM information from the string as a whole.
    for word do
        case $word in
            (To|[Bb]e|[Ff]illed|[Bb]y|O.E.M.|OEM|Not|Applicable|Specified|System|Product|Name|Version|Undefined|Default|string|INVALID|Type1ProductConfigId|OpenBSD)
                continue
                ;;
        esac
        host="$host$word "
    done

    # '$arch' is the cached output from 'uname -m'.
    log host "${host:-$arch}" >&6
}

get_uptime() {
    # Uptime works by retrieving the data in total seconds and then
    # converting that data into days, hours and minutes using simple
    # math.
    case $os in
        (*BSD* | DragonFly*)
            s=$(sysctl -n kern.boottime)
            # OpenBSD prints plain seconds since epoch. FreeBSD and
            # DragonFly print the following format:
            # [...] { sec = 1271934886, usec = 667779 } Thu Apr 22 ...
            # Both forms are handled by the two expansions below.
            s=${s#*=}
            s=${s%,*}
            s=$(($(date +%s) - s))
            ;;
    esac

    # Convert the uptime from seconds into days, hours and minutes.
    d=$((s / 60 / 60 / 24))
    h=$((s / 60 / 60 % 24))
    m=$((s / 60 % 60))

    # Only append days, hours and minutes if they're non-zero.
    case "$d" in ([!0]*) uptime="${uptime}${d}d " ;; esac
    case "$h" in ([!0]*) uptime="${uptime}${h}h " ;; esac
    case "$m" in ([!0]*) uptime="${uptime}${m}m " ;; esac

    log uptime "${uptime:-0m}" >&6
}

get_pkgs() {
    # This works by printing each package manager's package list with
    # each package one per line. The output is then piped to 'wc -l'.
    packages=$(
        case $os in
            (FreeBSD* | DragonFly*)
                pkg info
                ;;
            (OpenBSD*)
                printf '%s\n' /var/db/pkg/*/
                ;;
            (NetBSD*)
                pkg_info
                ;;
        esac | wc -l
    )

    # 'wc -l' can have leading and/or trailing whitespace depending on
    # the implementation, so strip them.
    packages=${packages#"${packages%%[![:space:]]*}"}
    packages=${packages%"${packages##*[![:space:]]}"}

    case $os in
        # OpenBSD's wc prints whitespace before the output
        # which needs to be stripped.
        (OpenBSD) packages=$((packages)) ;;
    esac

    case $packages in
        (1?* | [2-9]*) log pkgs "$packages" >&6 ;;
    esac
}

get_memory() {
    case $os in
        (OpenBSD*)
            mem_full=$(($(sysctl -n hw.physmem) / 1024 / 1024))

            # BUGFIX (was: 3rd field of 'vmstat' == 'avm', i.e. active
            # *virtual* memory, which can exceed physical RAM).
            #
            # Locate the 'fre' column (size of the free page list) by
            # name in the vmstat header instead of by a hardcoded
            # position, then compute:
            #     mem_used = hw.physmem - fre
            # which equals active + inactive + wired pages.
            {
                read -r _
                read -r vmstat_header
                read -r vmstat_data
            } <<-EOF
$(vmstat)
EOF
            # shellcheck disable=2046,2086
            {
                set -f
                set +f -- $vmstat_header
            }
            fre_idx=0
            idx=0
            for f do
                idx=$((idx + 1))
                [ "$f" = "fre" ] && { fre_idx=$idx; break; }
            done

            # shellcheck disable=2046,2086
            {
                set -f
                set +f -- $vmstat_data
            }
            idx=0
            fre_val=
            for f do
                idx=$((idx + 1))
                [ "$idx" -eq "$fre_idx" ] && { fre_val=$f; break; }
            done

            # Convert the scaled value ('384K', '4M', '1G' ...) to MiB.
            fre_num=${fre_val%[A-Z]}
            case $fre_val in
                (*K) fre_mb=$((fre_num / 1024)) ;;
                (*M) fre_mb=$fre_num ;;
                (*G) fre_mb=$((fre_num * 1024)) ;;
                (*T) fre_mb=$((fre_num * 1048576)) ;;
                (*)  fre_mb=$((fre_num / 1048576)) ;;
            esac

            mem_used=$((mem_full - fre_mb))
            [ "$mem_used" -lt 0 ] && mem_used=0
            ;;

        # Used memory is calculated using the following "formula":
        # mem_full - ((inactive + free + cache) * page_size / 1024 / 1024)
        (FreeBSD* | DragonFly*)
            mem_full=$(($(sysctl -n hw.physmem) / 1024 / 1024))

            # Use 'set --' to store the output of the command in the
            # argument list. POSIX sh has no arrays but this is close
            # enough.
            # shellcheck disable=2046
            {
                set -f
                set +f -- $(sysctl -n hw.pagesize \
                                    vm.stats.vm.v_inactive_count \
                                    vm.stats.vm.v_free_count \
                                    vm.stats.vm.v_cache_count)
            }

            # $1: hw.pagesize
            # $2: vm.stats.vm.v_inactive_count
            # $3: vm.stats.vm.v_free_count
            # $4: vm.stats.vm.v_cache_count
            mem_used=$((mem_full - (($2 + $3 + $4) * $1 / 1024 / 1024)))
            ;;

        (NetBSD*)
            mem_full=$(($(sysctl -n hw.physmem64) / 1024 / 1024))
            page=$(sysctl -n hw.pagesize)
            free_p=$(sysctl -n vm.stats.vm.v_free_count)
            inact_p=$(sysctl -n vm.stats.vm.v_inactive_count)
            cache_p=$(sysctl -n vm.stats.vm.v_cache_count)

            case $free_p$inact_p in
                (*[0-9]*)
                    mem_used=$((mem_full -
                                ((free_p + inact_p + ${cache_p:-0}) *
                                 page / 1024 / 1024)))
                    ;;
                (*)
                    # Fallback: NetBSD implements part of the Linux
                    # '/proc' filesystem when procfs(5) is mounted.
                    while IFS=':k ' read -r key val _; do
                        case $key in
                            (MemFree)
                                mem_free=$((val / 1024))
                                break
                                ;;
                        esac
                    done < /proc/meminfo
                    mem_used=$((mem_full - ${mem_free:-0}))
                    ;;
            esac
            ;;
    esac

    log memory "${mem_used:-?}M / ${mem_full:-?}M" >&6
}

get_disk() {
    # Report the size of every real (device backed) filesystem.
    # OpenBSD for example splits /, /tmp, /var, /usr and /home into
    # their own partitions - each one gets its own line here.
    #
    # 'df -hP' output format (POSIX -P keeps it one line per fs):
    # Filesystem  Size  Used Avail Capacity  Mounted-on
    # /dev/wd0a   1.5G  1.2G  200M    86%    /
    while read -r fs size used avail cap mnt; do
        # Skip the header and all pseudo filesystems (kernfs,
        # procfs, fdesc, tmpfs, ...): only real devices count.
        case $fs in
            (/dev/*) ;;
            (*) continue ;;
        esac

        log disk "$mnt  $used / $size ($cap)" >&6
    done <<-EOF
$(df -hP 2>/dev/null)
EOF
}

get_wm() {
    # Don't display window manager if X isn't running.
    [ "$DISPLAY" ] || return

    # xprop can be used to grab the window manager's properties
    # which contains the window manager's name under '_NET_WM_NAME'.
    has xprop && {
        # The output of the ID command is as follows:
        # _NET_SUPPORTING_WM_CHECK: window id # 0x400000
        id=$(xprop -root -notype _NET_SUPPORTING_WM_CHECK)
        id=${id##* }

        wm=$(xprop -id "$id" -notype -len 25 -f _NET_WM_NAME 8t)
    }

    # Handle cases of a window manager _not_ populating the
    # '_NET_WM_NAME' atom by checking the process list for the
    # select few window managers which don't set it.
    case $wm in
        (*'_NET_WM_NAME = '*)
            wm=${wm##*_NET_WM_NAME = \"}
            wm=${wm%%\"*}
            ;;
        (*)
            while read -r ps_line; do
                case $ps_line in
                    (*catwm*)     wm=catwm ;;
                    (*fvwm*)      wm=fvwm ;;
                    (*dwm*)       wm=dwm ;;
                    (*2bwm*)      wm=2bwm ;;
                    (*monsterwm*) wm=monsterwm ;;
                    (*wmaker*)    wm='Window Maker' ;;
                    (*sowm*)      wm=sowm ;;
                    (*penrose*)   wm=penrose ;;
                esac
            done <<-EOF
$(ps x)
EOF
            ;;
    esac

    log wm "$wm" >&6
}

get_de() {
    # Display the value of '$XDG_CURRENT_DESKTOP', if it's empty,
    # display the value of '$DESKTOP_SESSION'.
    log de "${XDG_CURRENT_DESKTOP:-$DESKTOP_SESSION}" >&6
}

get_shell() {
    # Display the basename of the '$SHELL' environment variable.
    log shell "${SHELL##*/}" >&6
}

get_editor() {
    # Display the value of '$VISUAL', if it's empty, display the
    # value of '$EDITOR'.
    editor=${VISUAL:-"$EDITOR"}
    log editor "${editor##*/}" >&6
}

get_palette() {
    # Print the first 8 terminal colors. This uses the existing
    # sequences to change text color with a sequence prepended
    # to reverse the foreground and background colors.
    # shellcheck disable=2154
    {
        esc SGR 7
        palette="$e$c1 $c1 $c2 $c2 $c3 $c3 $c4 $c4 $c5 $c5 $c6 $c6 "
        esc SGR 0
        palette="$palette$e"
    }

    # Print the palette with a new-line before and afterwards but no seperator.
    printf '\n' >&6
    log "$palette\n" " " " " >&6
}

get_ascii() {
    # This is a simple function to read the contents of
    # an ascii file from 'stdin'. It allows for the use
    # of '<<-EOF' to prevent the break in indentation in
    # this source code.
    #
    # This function also sets the text colors according
    # to the ascii color.
    read_ascii() {
        # 'PF_COL1': Set the info name color according to ascii color.
        # 'PF_COL3': Set the title color to some other color. ¯\_(ツ)_/¯
        PF_COL1=${PF_COL1:-${1:-7}}
        PF_COL3=${PF_COL3:-$((${1:-7}%8+1))}

        while IFS= read -r line; do
            ascii="$ascii$line
"
        done
    }

    # This checks for ascii art in the following order:
    # '$1':        Argument given to 'get_ascii()' directly.
    # '$PF_ASCII': Environment variable set by user.
    # '$distro':   The detected distribution name.
    # '$os':       The name of the operating system/kernel.
    #
    # NOTE: Each ascii art below is indented using tabs, this
    #       allows indentation to continue naturally despite
    #       the use of '<<-EOF'.
    # shellcheck disable=2154
    case ${1:-${PF_ASCII:-${distro:-$os}}} in
        ([Dd]ragon[Ff]ly*)
            read_ascii 1 <<-EOF
	,${c1}_${c7},
	('-_${c1}|${c7}_-')
	>--${c1}|${c7}--<
	(_-'${c1}|${c7}'-_)
	${c1}|
	${c1}|
	${c1}|
EOF
            ;;
        ([Ff]ree[Bb][Ss][Dd]*)
            read_ascii 1 <<-EOF
	${c1}/\\,-'''''-,/\\
	\\_)       (_/
	|           |
	|           |
	;         ;
	'-_____-'
EOF
            ;;
        ([Nn]et[Bb][Ss][Dd]*)
            read_ascii 3 <<-EOF
	${c7}\\\\${c3}\`-______,----__
	${c7} \\\\        ${c3}__,---\`_
	${c7}  \\\\       ${c3}\`.____
	${c7}   \\\\${c3}-______,----\`-
	${c7}    \\\\
	${c7}     \\\\
	${c7}      \\\\
EOF
            ;;
        ([Oo]pen[Bb][Ss][Dd]*)
            read_ascii 3 <<-EOF
	${c3}      _____
	${c3}    \\-     -/
	${c3} \\_/         \\
	${c3} |        ${c7}O O${c3} |
	${c3} |_  <   )  3 )
	${c3} / \\         /
	${c3}   /-_____-\\
EOF
            ;;
        (*)
            # On no match of a distribution ascii art, this function
            # calls itself again, this time to look for a more generic
            # OS related ascii art.
            [ "$1" ] || {
                get_ascii "$os"
                return
            }
            printf 'error: %s is not currently supported.\n' "$os" >&6
            printf 'error: Open an issue for support to be added.\n' >&6
            exit 1
            ;;
    esac

    # Store the "width" (longest line) and "height" (number of lines)
    # of the ascii art for positioning. The 'sed' is used to strip
    # '\033[3Xm' color codes from the ascii art so they don't affect
    # the width variable.
    while read -r line; do
        ascii_height=$((${ascii_height:-0} + 1))
        [ "${#line}" -gt "${ascii_width:-0}" ] &&
            ascii_width=${#line}
    done <<-EOF
$(printf %s "$ascii" | sed 's/\x1b\[3.m//g')
EOF

    # Add a gap between the ascii art and the information.
    ascii_width=$((ascii_width + 4))

    # Print the ascii art and position the cursor back where we
    # started prior to printing it.
    {
        esc_p SGR 1
        printf '%s' "$ascii"
        esc_p SGR 0
        esc_p CUU "$ascii_height"
    } >&6
}

main() {
    case $* in
        -v)
            printf '%s 1.0.0\n' "${0##*/}"
            return 0
            ;;
        -d)
            # Below exec is not run, stderr is shown.
            ;;
        '')
            exec 2>/dev/null
            ;;
        *)
            cat <<EOF
${0##*/}     show system information (BSD only)
${0##*/} -d  show stderr (debug mode)
${0##*/} -v  show version information
EOF
            return 0
            ;;
    esac

    # Hide 'stdout' and selectively print to it using '>&6'.
    # This gives full control over what it displayed on the screen.
    exec 6>&1 >/dev/null

    # Store raw escape sequence character for later reuse.
    esc_c=$(printf '\033')

    # Allow the user to execute their own script and modify or
    # extend bsdfetch's behavior.
    # shellcheck source=/dev/null
    ! [ -f "$PF_SOURCE" ] || . "$PF_SOURCE"

    # Ensure that the 'TMPDIR' is writable as heredocs use it and
    # fail without the write permission.
    [ -w "${TMPDIR:-/tmp}" ] || export TMPDIR=~

    # Generic color list.
    # shellcheck disable=2034
    for _c in c1 c2 c3 c4 c5 c6 c7 c8; do
        esc SGR "3${_c#?}" 0
        export "$_c=$e"
    done

    # Disable line wrapping and catch the EXIT signal to enable it
    # again on exit.
    esc_p DECAWM l >&6
    trap 'esc_p DECAWM h >&6' EXIT

    # Store the output of 'uname' to avoid calling it multiple times
    # throughout the script.
    read -r os kernel arch <<-EOF
$(uname -srm)
EOF

    # Always run 'get_os' for the purposes of detecting which ascii
    # art to display.
    get_os

    # Allow the user to specify the order and inclusion of information
    # functions through the 'PF_INFO' environment variable.
    # shellcheck disable=2086
    {
        set -f
        set +f -- ${PF_INFO-ascii title os host kernel uptime pkgs memory disk}

        # Iterate over the info functions to determine the lengths of
        # the "info names" for output alignment.
        for info do
            command -v "get_$info" >/dev/null || continue
            [ "${#info}" -gt "${info_length:-0}" ] &&
                info_length=${#info}
        done

        # Add an additional space of length to act as a gap.
        info_length=$((info_length + 1))

        # Iterate over the above list and run any existing "get_" functions.
        for info do
            "get_$info"
        done
    }

    # Position the cursor below both the ascii art and information lines
    # according to the height of both. If the information exceeds the
    # ascii art in height, don't touch the cursor, else move it down
    # N lines.
    [ "${info_height:-0}" -lt "${ascii_height:-0}" ] &&
        cursor_pos=$((ascii_height - info_height))

    while [ "${i:=0}" -le "${cursor_pos:-0}" ]; do
        printf '\n'
        i=$((i + 1))
    done >&6
}

main "$@"
